;; Port of ofc and obfc from bfc-xp.metta to MM2.
;;
;; Important: in order to run that code you must first run
;; gen-peano.mm2 and gen-lte.mm2, in that order.
;;
;; Notes regarding optimization:
;;
;; 1. It was found that the converse of : is 20% faster, thus used and
;;    abbreviated to c: in spite of being less common.
;;
;; 2. Moving the hypotheses count at the end of sol showed no
;;    improvement.
;;
;; 3. Using c: instead of : in axiom does not change performance.  But
;;    maybe it is due to the small number of axioms.
;;
;; 4. Moving the body of the pure function as data (using =pure) slows
;;    down the search by 30%.  That is why it is performed while
;;    producing the axiom and mpⁱ exec commands, as opposed to while
;;    executing them.
;;
;; 5. Regarding pattern ordering.  Pattern ordering of mpⁱ application
;;    has no impact on performance.  Pattern ordering of axiom
;;    application has major impact.  The least efficient ordering is
;;
;;      (axiom (c: $ap $an))
;;      (sol $ski $shi $flag (c: (-> $ap $b) $f))
;;      (decFn $shi $hi)
;;
;;    which takes 30s on jarr.
;;
;;    Then
;;
;;      (sol $ski $shi $flag (c: (-> $ap $b) $f))
;;      (axiom (c: $ap $an))
;;      (decFn $shi $hi)
;;
;;    which takes 9s on jarr.
;;
;;    Finally, the most efficient ordering is
;;
;;      (decFn $shi $hi)
;;      (sol $ski $shi $flag (c: (-> $ap $b) $f))
;;      (axiom (c: $ap $an))
;;
;;    which takes 300ms on jarr.  Swapping sol and axiom, if decFn
;;    appears first, has no impact on performance.
;;
;;    Why these orderings have such impacts on performances is a
;;    mystery to me.  Especially the fact that placing decFn first
;;    yields the best performance since none of the variables in
;;    `(decFn $shi $hi)` are known at the time of pattern matching.
;;    Even weirder is the fact that the size of decFn does not seem to
;;    matter (as long as it is large enough to work properly, i.e. up
;;    to 13 for jarr, etc).
;;
;; 6. Converting at the start integers from string to i8, to produce
;;    target_i8, sol_i8, etc, then doing the internal calculations
;;    solely with i8 gives no measurable speed up.  However having to
;;    converte from sol_i8 to sol, then removing all sol_i8 at the
;;    end, incurs a significant slow-down (2.3x slower in loowoz).
;;    This is likely due to the enormous volume of sol_i8 instances.
;;
;; 7. Using shorter symbols such as s instead of sol, p instead 𝜑, etc
;;    brings a tiny speed up but no more than 1%.
;;
;; 8. Solving multiple problems at once by enabling multiple targets
;;    can speed things up a bit.  Although it is not clear if this is
;;    due to pre and post computation being amortized or if actual
;;    compression accross problems is taking place.  Comparing the
;;    time of all problems running at once from impid to pm2.27,
;;    1.062s, to the sum of all times running the problems
;;    sequentially, 0.007+0.007+0.017+0.557+0.505=1.093s, we can
;;    measure a 3% speed-up (a speed-up factor of 1.03x).  Up to
;;    loowoz, we get a time of 2m23.301s for all at once, and in
;;    sequence we get a time of 1.093+3.268+2m22.918=2m27.279s,
;;    corresponding to 3% speed-up as well.
;;
;; Times are obtained by running on an Intel(R) Xeon(R) E3-1535M v6
;; (8) @ 4.20 GHz
;;
;; Notes regarding representation:
;;
;; The solution space is represented as follows
;;
;; (sol MPS HYPCNT FLAG (c: THRM PRF))
;;
;; where
;; - MPS is the remaining proof size budget.
;;
;; - HYPCNT is the number of hypotheses of THRM.
;;
;; - FLAG is a flag indicating whether PRF can be expanded by applying
;;   mpⁱ to it.  FLAG is set to 1 if HYPCNT <= (MPS - 1), 0 otherwise.
;;   A flag indicating whether PRF can be expanded by applying it to
;;   an axiom is not needed because this is always possible (it should
;;   be easy to prove by structural induction).

;;;;;;;;;;;;
;; Theory ;;
;;;;;;;;;;;;

(axiom (c: (→ $𝜑 (→ $𝜓 $𝜑)) ax₁))
(axiom (c: (→ (→ $𝜑 (→ $𝜓 $𝜒)) (→ (→ $𝜑 $𝜓) (→ $𝜑 $𝜒))) ax₂))
(axiom (c: (→ (→ (¬ $𝜑) (¬ $𝜓)) (→ $𝜓 $𝜑)) ax₃))

;;;;;;;;;;;;;;;;;;;;;;
;; Pure Definitions ;;
;;;;;;;;;;;;;;;;;;;;;;

;; Output 1 if the corresponding proof is mpⁱ expandable, meaning its
;; hypotheses count is less than or equal to the remaining size
;; budget minus 1.  Output 0 otherwise.
(=pure (is_mpⁱ_expandable $budget $hypcnt)
       (ifnz (lte_i8 $hypcnt (sub_i8 $budget (i8_one))) then 1 else 0))

;;;;;;;;;;
;; Main ;;
;;;;;;;;;;

;; Define target query, of the form
;;
;; (target MAX_PROOF_SIZE QUERY)

;; ;; impid (Implied Identity) (size=3, time=0.007s)
;; (target 3 (c: (→ (→ 𝜑 𝜓) (→ 𝜑 𝜑)) $x))

;; ;; id (size=5, time=0.007s, time-up-to=0.009s)
;; (target 5 (c: (→ 𝜑 𝜑) $x))

;; ;; pm2.43 (size=7, time=0.017s, time-up-to=0.019s)
;; (target 7 (c: (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓)) $x))

;; jarr (size=13, time=0.557s, time-up-to=0.562s)
(target 13 (c: (→ (→ (→ 𝜑 𝜓) 𝜒) (→ 𝜓 𝜒)) $x))

;; ;; pm2.27 (size=13, time=505s, time-up-to=1.062s)
;; (target 13 (c: (→ 𝜑 (→ (→ 𝜑 𝜓) 𝜓)) $x))

;; ;; imim1 (size=15, time=3.268s, time-up-to=4.222s)
;; (target 15 (c: (→ (→ 𝜑 𝜓) (→ (→ 𝜓 𝜒) (→ 𝜑 𝜒))) $x))

;; ;; loowoz (size=19, time=2m22.918s, time-up-to=2m23.301s)
;; (target 19 (c: (→ (→ (→ 𝜑 𝜓) (→ 𝜑 𝜒)) (→ (→ 𝜓 𝜑) (→ 𝜓 𝜒))) $x))

;; ;; pm2.83 (size=25, time=109m45.370s)
;; (target 25 (c: (→ (→ 𝜑 (→ 𝜓 𝜒)) (→ (→ 𝜑 (→ 𝜒 𝜃)) (→ 𝜑 (→ 𝜓 𝜃)))) $x))

;; ;; loolin (size=26, time=?)
;; (target 26 (c: (→ (→ (→ 𝜑 𝜓) (→ 𝜓 𝜑)) (→ 𝜓 𝜑)) $x))

;; Load Peano to Integer conversion.  Make sure that gen-peano.mm2 has
;; been previously executed.  Warning: the tables will contain actual
;; i8 integers, not strings.
(exec (0)
      (I (ACT peano (toPeanoFn $x $k)))
      (O (pure (toPeanoFn_i8 $i $k) $i (i8_from_string $x))
         (pure (fromPeanoFn_i8 $k $i) $i (i8_from_string $x))))

;; Precompute increment and decrement tables for integer.  Warning:
;; the tables contain i8 not strings.
(exec (1)
      (, (fromPeanoFn_i8 $x $y)
         (fromPeanoFn_i8 (S $x) $sy))
      (, (incFn_i8 $y $sy)
         (decFn_i8 $sy $y)))

;; Convert target from string integer to i8 integer
(exec (1)
      (, (target $s $q))
      (O (pure (target_i8 $i $q) $i (i8_from_string $s))))

;; Turn target into initial source and forward chaining loop
(exec (2)
      (, (target_i8 $mps (c: $ta $tx))
         (toPeanoFn_i8 $mps $mps_n)
         (=pure (is_mpⁱ_expandable $mps (i8_one)) $bdyi))
      (O ;; Initialize source
         (pure $isol $isol
               (tuple sol_i8 $mps (i8_one) $bdyi (' (c: (-> $ta $ta) I))))
         ;; Expand one step forward
         (+ (exec (2 $mps_n)
                  (, ;; Capture inner self
                     (exec (2 (S $k)) $ptrn $tplt)
                     ;; Grab integers of remaining budget
                     (fromPeanoFn_i8 (S $k) $ski)
                     (fromPeanoFn_i8 $k $ki)
                     ;; Grab is_mpⁱ_expandable bodies (for axiom and mpⁱ)
                     (=pure (is_mpⁱ_expandable $ki $hi) $bdya)
                     (=pure (is_mpⁱ_expandable $ki $shi) $bdym))
                  (, ;; Apply current proof to axiom
                     (exec (3 0)
                           (, (decFn_i8 $shi $hi)
                              (sol_i8 $ski $shi $flag (c: (-> $ap $b) $f))
                              (axiom (c: $ap $an)))
                           (O (pure (sol_i8 $ki $hi $ra (c: $b ($f $an)))
                                    $ra
                                    $bdya)))
                     ;; Apply mpⁱ to current proof
                     (exec (4 0)
                           (, (sol_i8 $ski $hi 1 (c: (-> $b $c) $f))
                              (incFn_i8 $hi $shi))
                           (O (pure (sol_i8 $ki $shi $rm
                                            (c: (-> (→ $a $b) (-> $a $c)) (mpⁱ $f)))
                                    $rm
                                    $bdym)))
                     ;; Respawn inner self
                     (exec (5 0) (,)
                           (, (exec (2 $k) $ptrn $tplt))))))))

;; Convert sol from i8 integer to string integer
(exec (3 0 0)
      (, (sol_i8 $budget $hypcnt $flag $result))
      (O (pure $csol $csol (tuple sol
                                  (i8_to_string $budget)
                                  (i8_to_string $hypcnt)
                                  $flag
                                  (' $result)))))

;; Unify solution with target when maximum budget and hypotheses count
;; falls to zero.
(exec (4 0 0)
      (, (target $mps (c: $ta $tx))
         (sol 0 0 $flag (c: $ta $tx)))
      (, (final 0 0 $flag (c: $ta $tx))))

;; Remove i8 binary relations
(exec (5 0 0)
      (,)
      (, (binRelToRemove target_i8)
         (binRelToRemove toPeanoFn_i8)
         (binRelToRemove fromPeanoFn_i8)
         (binRelToRemove incFn_i8)
         (binRelToRemove decFn_i8)))
(exec (5 0 1)
      (, (binRelToRemove $r)
         ($r $x $y))
      (O (- (binRelToRemove $r))
         (- ($r $x $y))))

;; Remove i8 sol relation
(exec (6 0 0)
      (, (sol_i8 $budget $hypcnt $flag $result))
      (O (- (sol_i8 $budget $hypcnt $flag $result))))
