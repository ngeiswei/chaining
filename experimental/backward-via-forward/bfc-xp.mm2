;; Port of ofc and obfc from bfc-xp.metta to MM2.
;;
;; Important: in order to run that code you must first run
;; gen-peano.mm2 and gen-lte.mm2, in that order.
;;
;; Notes regarding optimization:
;;
;; 1. It was found that the converse of : is 20% faster, thus used and
;;    abbreviated to c: in spite of being less common.
;;
;; 2. Moving the hypotheses count at the end of sol showed no
;;    improvement.
;;
;; 3. using c: instead of : in axiom does not change performance.  But
;;    maybe it is due to the small number of axioms.
;;
;; Times are obtained by running on an Intel(R) Xeon(R) E3-1535M v6
;; (8) @ 4.20 GHz
;;
;; The solution space is represented as follows
;;
;; (sol MPS HYPCNT FLAG (c: THRM PRF))
;;
;; where
;; - MPS is the remaining proof size budget.
;;
;; - HYPCNT is the number of hypotheses of THRM.
;;
;; - FLAG is a flag indicating whether PRF can be expanded by applying
;;   mpⁱ to it.  FLAG is set to 1 if HYPCNT <= (MPS - 1), 0 otherwise.
;;   A flag indicating whether PRF can be expanded by applying it to
;;   an axiom is not needed because this is always possible (NEXT:
;;   proof it by induction).

;;;;;;;;;;;;
;; Theory ;;
;;;;;;;;;;;;

(axiom (c: (→ $𝜑 (→ $𝜓 $𝜑)) ax₁))
(axiom (c: (→ (→ $𝜑 (→ $𝜓 $𝜒)) (→ (→ $𝜑 $𝜓) (→ $𝜑 $𝜒))) ax₂))
(axiom (c: (→ (→ (¬ $𝜑) (¬ $𝜓)) (→ $𝜓 $𝜑)) ax₃))

;;;;;;;;;;;;;;;;;;;
;; Flag Function ;;
;;;;;;;;;;;;;;;;;;;

;; NEXT: move $flag to its own function to avoid duplicating code.

;;;;;;;;;;
;; Main ;;
;;;;;;;;;;

;; Define target query, of the form
;;
;; (target MAX_PROOF_SIZE QUERY)

;; ;; id (size=5, time=0.006s)
;; (target 5 (c: (→ 𝜑 𝜑) $x))

;; ;; pm2.43 (size=7, time=0.009s)
;; (target 7 (c: (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓)) $x))

;; jarr (size=13, time=8.605s)
(target 13 (c: (→ (→ (→ 𝜑 𝜓) 𝜒) (→ 𝜓 𝜒)) $x))

;; ;; imim1 (size=15, time=5m40.939s)
;; (target 15 (c: (→ (→ 𝜑 𝜓) (→ (→ 𝜓 𝜒) (→ 𝜑 𝜒))) $x))

;; ;; loowoz (size=19, time=?)
;; (target 19 (c: (→ (→ (→ 𝜑 𝜓) (→ 𝜑 𝜒)) (→ (→ 𝜓 𝜑) (→ 𝜓 𝜒))) $x))

;; ;; pm2.83 (size=25, time=?)
;; !(target 25 (c: (→ (→ 𝜑 (→ 𝜓 𝜒)) (→ (→ 𝜑 (→ 𝜒 𝜃)) (→ 𝜑 (→ 𝜓 𝜃)))) $x))

;; ;; loolin (size=26, time=?)
;; !(target 26 (c: (→ (→ (→ 𝜑 𝜓) (→ 𝜓 𝜑)) (→ 𝜓 𝜑)) $x))

;; Load Peano to Integer conversion.  Make sure that
;; gen-peano.mm2 has been previously executed.
(exec (0)
      (I (ACT peano (toPeanoFn $x $k)))
      (, (toPeanoFn $x $k)
         (fromPeanoFn $k $x)))

;; Precompute increment and decrement tables for integer.
(exec (1)
      (, (fromPeanoFn $x $y)
         (fromPeanoFn (S $x) $sy))
      (, (incFn $y $sy)
         (decFn $sy $y)))

;; Turn target into initial source and forward chaining loop
(exec (2)
      (, (target $mps (c: $ta $tx))
         (toPeanoFn $mps $mps_n))
      (O ;; Initialize source
         (pure (sol $mps 1 $bb (c: (-> $ta $ta) I))
               $bb
               (ifnz (lte_i8 (i8_one) (sub_i8 (i8_from_string $mps) (i8_one))) then 1 else 0))
         ;; Expand one step forward
         (+ (exec (2 $mps_n)
                  (, ;; Capture inner self
                     (exec (2 (S $k)) $ptrn $tplt)
                     ;; Grab corresponding integers
                     (fromPeanoFn (S $k) $ski)
                     (fromPeanoFn $k $ki))
                  (, ;; Apply current proof to axiom
                     (exec (3 0)
                           (, ;; Unify solution f and axiom an so that
                              ;; (f an) is compatible
                              (sol $ski $shi $flag (c: (-> $ap $b) $f))
                              (axiom (c: $ap $an))
                              (decFn $shi $hi))
                           (O (pure (sol $ki $hi $nuflag (c: $b ($f $an)))
                                    $nuflag
                                    (ifnz (lte_i8 (i8_from_string $hi)
                                                  (sub_i8 (i8_from_string $ki) (i8_one)))
                                          then 1 else 0))))
                     ;; Apply mpⁱ to current proof
                     (exec (4 0)
                           (, (sol $ski $hi 1 (c: (-> $b $c) $f))
                              (incFn $hi $shi))
                           (O (pure (sol $ki $shi $nuflag
                                         (c: (-> (→ $a $b) (-> $a $c)) (mpⁱ $f)))
                                    $nuflag
                                    (ifnz (lte_i8 (i8_from_string $shi)
                                                  (sub_i8 (i8_from_string $ki) (i8_one)))
                                           then 1 else 0))))
                     ;; Respawn inner self
                     (exec (5 0) (,)
                           (, (exec (2 $k) $ptrn $tplt))))))))

;; Unify solution with target when maximum depth and hypotheses count
;; falls to zero.
(exec (3 0 0)
      (, (target $mps (c: $ta $tx))
         (sol 0 0 $flag (c: $ta $tx)))
      (, (final 0 0 (c: $ta $tx))))
