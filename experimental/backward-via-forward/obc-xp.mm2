;; Vanilla backward chainer for MORK, explicitly using backward
;; recursion as opposed to forward chaining.  It is a direct port of
;; obc from [bfc-xp.metta](bfc-xp.metta) and essentially following the
;; idea of [pc-bc.mm2](../metamath/benchmark).
;;
;; WARNING: don't forget to run [gen-peano.mm2](gen-peano.mm2) and
;; [gen-lte.mm2](gen-lte.mm2) prior to running that code.

;;;;;;;;;;;;;;;;;;;;;
;; Knowledge Bases ;;
;;;;;;;;;;;;;;;;;;;;;

;; Axiom base
(ab (: ax₁ (→ $𝜑 (→ $𝜓 $𝜑))))
(ab (: ax₂ (→ (→ $𝜑 (→ $𝜓 $𝜒)) (→ (→ $𝜑 $𝜓) (→ $𝜑 $𝜒)))))
(ab (: ax₃ (→ (→ (¬ $𝜑) (¬ $𝜓)) (→ $𝜓 $𝜑))))

;;;;;;;;;;;;;;;;;;;;;;
;; Backward Chainer ;;
;;;;;;;;;;;;;;;;;;;;;;

;; Define obc, for optimized backward chainer, in terms of exec
;; commands.  It represents intermediary solutions as follows
;;
;; (sol PATH PROOF_SIZE (: PROOF THEOREM))
;;
;; where
;;
;; - PATH: path of the lemma from the root of the target proof.  A
;;   path indicates a branch of the proof tree, a sequence of search
;;   nodes, where each search node can be either
;;
;;   - `.` corresponding to the root node
;;
;;   - `0` corresponding to the branch proving the first premise
;;
;;   - `(1ST_PREMISE_PROOF 1)` corresponding to the branch proving the
;;     second premise given that the proof of the first premise is
;;     1ST_PREMISE_PROOF.
;;
;;   So for instance
;;
;;   (sol . 7 (: (mp (mp ax₂ ax₂) (mp ax₂ ax₁)) (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓))))
;;
;;   indicates a full proof of the target theorem.  While
;;
;;   (sol (. 0) 3 (: (mp ax₂ ax₂) (→ (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜑)) (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓)))))
;;
;;   indicates a proof of the first premise of the inference rule `mp`
;;   at the root of the proof tree.
;;
;;   Likewise
;;
;;   (sol ((. 0) (ax₂ 1)) 1 (: ax₂ (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ (→ 𝜑 𝜑) (→ 𝜑 𝜓)))))
;;
;;   indicates a proof of the lemma of the second premise of the first
;;   premise of the root, `(mp ax₂ ax₂)`.
;;
;; - PROOF_SIZE: size of PROOF
;;
;; - PROOF: proof
;;
;; - THEOREM: theorem

;; Base case (nullary).  The budget needs to be at least 1 for the
;; axiom.
(= (obc $budget $path (: $x $a))
   (exec (0 $path obc_nullary)
         (, (lte 1 $budget)
            (ab (: $x $a)))
         (, (sol $path 1 (: $x $a)))))

;; Recursive step (product)
;;
;; WARNING: supports only binary product because obc is called on
;; second premise instead of obc_prod.
(= (obc_prod $budget $path (: (, $x $y) (, $a $b)))
   (exec (1 $path obc_product_init)
         (, ;; The budget needs to be at least 2, 1 for the first
            ;; argument and 1 for second argument.  The product itself
            ;; does not cost anything because it is a virtual
            ;; intermediary proof step.
            (lte 2 $budget)
            ;; Calculate budget of first argument
            (plusFn 1 $bx $budget)
            ;; Grab bang evaluator for premise 1
            (evaluate-bangs $evaluate-bangs-1))
         (, ;; Recurse on first premise
            (! (obc $bx ($path 0) (: $x $a)))
            ;; Evaluate all function calls prefixed by a bang
            $evaluate-bangs-1
            ;; Resume recursion
            (exec (9 ($path 0) obc_product_2nd_arg)
                  (, ;; Get solutions of recursion on first premise
                     (sol ($path 0) $sx (: $x $a))
                     ;; Calculate budget for premise 2
                     (plusFn $sx $by $budget)
                     ;; Grab bang evaluator for premise 2
                     (evaluate-bangs $evaluate-bangs-2))
                  ;; Recurse on second premise
                  (, (! (obc $by ($path ($x 1)) (: $y $b)))
                     ;; Evaluate all function calls prefixed by a bang
                     $evaluate-bangs-2
                     ;; Resume recursion
                     (exec (9 ($path ($x 1)) obc_product_final)
                           (, ;; Retrieve proofs of premises
                              (sol ($path 0) $sx (: $x $a))
                              (sol ($path ($x 1)) $sy (: $y $b))
                              ;; Calculate product proof size
                              (plusFn $sx $sy $sp))
                           ;; Build product solution
                           (, (sol_prod $path $sp (: (, $x $y) (, $a $b))))))))))

;; Recursive step (modus ponens)
(= (obc $budget $path (: (mp $f $x) $b))
   (exec (1 $path obc_mp_init)
         (, ;; The budget needs to be at least 3, 1 for modus ponens,
            ;; 2 for the two premises (the product)
            (lte 3 $budget)
            ;; Calculate budget for product
            (plusFn 1 $bp $budget)
            ;; Grab bang evaluator
            (evaluate-bangs $evaluate-bangs))
         (, ;; Recurse on product
            (! (obc_prod $bp $path (: (, $f $x) (, (→ $a $b) $a))))
            ;; Evaluate all function calls prefixed by a bang
            $evaluate-bangs
            ;; Resume recursion
            (exec (9 $path obc_mp_final)
                  (, ;; Get solutions of product
                     (sol_prod $path $sp (: (, $f $x) (, (→ $a $b) $a)))
                     ;; Calculate size of modus ponens proof
                     (plusFn $sp 1 $s))
                  ;; Build mp solution
                  (, (sol $path $s (: (mp $f $x) $b)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Function call evaluator ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Evaluate all function calls prefixed by a bang
(evaluate-bangs (exec (5 * main)
                      (, (! $fx) (= $fx $bdy))
                      (O (- (! $fx)) (+ $bdy))))

;;;;;;;;;;
;; Main ;;
;;;;;;;;;;

;; Load Peano to Integer conversion.  Make sure that gen-peano.mm2 has
;; been previously executed.
(exec (0)
      (I (ACT peano (toPeanoFn $x $k)))
      (, (toPeanoFn $x $k)
         (fromPeanoFn $k $x)))

;; Load lte
(exec (1)
      (I (ACT lte (lte $x $y))
         (BTM (fromPeanoFn $x $xi))
         (BTM (fromPeanoFn $y $yi)))
      (, (lte $xi $yi)))

;; Generate plusFn
(exec (1)
      (, (fromPeanoFn $k $x)
         (fromPeanoFn $l $y))
      (O (pure (plusFn $x $y $z)
               $z
               (i8_to_string (sum_i8 (i8_from_string $x) (i8_from_string $y))))))

;; Turn target into obc call
(exec (2)
      (, (target $budget (: $x $a)))
      (, (! (obc $budget . (: $x $a)))))

;; Evaluate bangs
(exec (3)
      (, (evaluate-bangs $eb))
      (, $eb))

;; Unify solution with target when maximum budget and hypotheses count
;; falls to zero.
(exec (4 0 0 0)
      (, (target $budget (: $tx $ta))
         (sol . $prfsize (: $tx $ta)))
      (, (final . $prfsize (: $tx $ta))))

;; Remove extraneous binary relations
(exec (5 0 0 0)
      (,)
      (, (binRelToRemove toPeanoFn)
         (binRelToRemove fromPeanoFn)
         (binRelToRemove lte)))
(exec (5 0 0 1)
      (, (binRelToRemove $r)
         ($r $x $y))
      (O (- (binRelToRemove $r))
         (- ($r $x $y))))

;; Remove extraneous trinary relations
(exec (5 0 0 2)
      (,)
      (, (triRelToRemove sol_prod)
         (triRelToRemove plusFn)))
(exec (5 0 0 3)
      (, (triRelToRemove $r)
         ($r $x $y $z))
      (O (- (triRelToRemove $r))
         (- ($r $x $y $z))))

;; Uncomment the target(s) you wish to proof

;; impid (Implied Identity) (size=3, time=0.023s)
;; (target 3 (: $x (→ (→ 𝜑 𝜓) (→ 𝜑 𝜑))))

;; id (size=5, time=0.025s, time-up-to=0.025s)
;; (target 5 (: $x (→ 𝜑 𝜑)))

;; pm2.43 (size=7, time=0.057s, time-up-to=0.067s)
;; (target 7 (: $x (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓))))

jarr (size=13, time=135m36.343s, time-up-to=140m11.874s)
(target 13 (: $x (→ (→ (→ 𝜑 𝜓) 𝜒) (→ 𝜓 𝜒))))

