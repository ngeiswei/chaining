;; Vanilla backward chainer for MORK, explicitly using backward
;; recursion as opposed to forward chaining.  It is a direct port of
;; obc from [bfc-xp.metta](bfc-xp.metta) and essentially following the
;; idea of [pc-bc.mm2](../metamath/benchmark).
;;
;; WARNING: don't forget to run [gen-peano.mm2](gen-peano.mm2) and
;; [gen-lte.mm2](gen-lte.mm2) prior to running that code.

;; NEXT: decompose n-ary rules into product target ,.

;;;;;;;;;;;;;;;;;;;;;
;; Knowledge Bases ;;
;;;;;;;;;;;;;;;;;;;;;

;; Axiom base
(ab (: ax₁ (→ $𝜑 (→ $𝜓 $𝜑))))
(ab (: ax₂ (→ (→ $𝜑 (→ $𝜓 $𝜒)) (→ (→ $𝜑 $𝜓) (→ $𝜑 $𝜒)))))
;; (ab (: ax₃ (→ (→ (¬ $𝜑) (¬ $𝜓)) (→ $𝜓 $𝜑))))

;;;;;;;;;;;;;;;;;;;;;;
;; Backward Chainer ;;
;;;;;;;;;;;;;;;;;;;;;;

;; Define obc, for optimized backward chainer, in terms of exec
;; commands.  It represents intermediary solutions as follows
;;
;; (sol PATH PROOF_SIZE (: PROOF THEOREM))
;;
;; where
;;
;; - PATH: path of the lemma from the root of the target proof.  A
;;   path indicates a branch of the proof tree, a sequence of search
;;   nodes, where each search node can be either
;;
;;   - `.` corresponding to the root node
;;
;;   - `0` corresponding to the branch proving the first premise
;;
;;   - `(1ST_PREMISE_PROOF 1)` corresponding to the branch proving the
;;     second premise given that the proof of the first premise is
;;     1ST_PREMISE_PROOF.
;;
;;   So for instance
;;
;;   (sol . 7 (: (mp (mp ax₂ ax₂) (mp ax₂ ax₁)) (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓))))
;;
;;   indicates a full proof of the target theorem.  While
;;
;;   (sol (. 0) 3 (: (mp ax₂ ax₂) (→ (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜑)) (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓)))))
;;
;;   indicates a proof of the first premise of the inference rule `mp`
;;   at the root of the proof tree.
;;
;;   Likewise
;;
;;   (sol ((. 0) (ax₂ 1)) 1 (: ax₂ (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ (→ 𝜑 𝜑) (→ 𝜑 𝜓)))))
;;
;;   indicates a proof of the lemma of the second premise of the first
;;   premise of the root, `(mp ax₂ ax₂)`.
;;
;; - PROOF_SIZE: size of PROOF
;;
;; - PROOF: proof
;;
;; - THEOREM: theorem

;; Base case (nullary).  The budget needs to be at least 1 for the
;; axiom.
(= (obc $budget $path (: $x $a))
   (exec (0 $path obc_nullary)
         (, (lte 1 $budget)
            (ab (: $x $a)))
         (, (sol $path 1 (: $x $a)))))

;; Recursive step (modus ponens).  The budget needs to be at least 3,
;; 1 for modus ponens, 2 for the two premises.
(= (obc $budget $path (: (mp $f $x) $b))
   (exec (1 $path obc_mp_init)
         (, (lte 3 $budget))
         (O ;; Recurse on first premise
            (pure (! (obc $bf ($path 0) (: $f (→ $a $b))))
                  $bf
                  ;; Calculate new budget, $budget - 2, for premise 1
                  ;; NEXT: maybe check if new budget is greater than 1
                  (i8_to_string (sub_i8 (i8_from_string $budget) (i8_from_string 2))))
            ;; Evaluate all function calls prefixed by a bang
            (+ (exec (5 * main)
                     (, (! $fx) (= $fx $bdy))
                     (O (- (! $fx)) (+ $bdy))))
            ;; Resume recursion
            (+ (exec (9 ($path 0) obc_mp_2nd_arg)
                     (, ;; Get solutions of recursion on first premise
                        (sol ($path 0) $sf (: $f (→ $a $b))))
                     (O ;; Recurse on second premise
                        (pure (! (obc $bx ($path ($f 1)) (: $x $a)))
                              $bx
                              ;; Calculate new budget, $budget - $sf - 1, for premises 2
                              ;; NEXT: maybe check if new budget is greater than 1
                              (i8_to_string (sub_i8 (sub_i8 (i8_from_string $budget)
                                                            (i8_from_string $sf))
                                                    (i8_one))))
                        ;; Evaluate all function calls prefixed by a bang
                        (+ (exec (5 * main)
                                 (, (! $fx) (= $fx $bdy))
                                 (O (- (! $fx)) (+ $bdy))))
                        ;; Resume recursion
                        (+ (exec (9 ($path ($f 1)) obc_mp_final)
                                 (, (sol ($path 0) $sf (: $f (→ $a $b)))
                                    (sol ($path ($f 1)) $sx (: $x $a))
                                    ;; Calculate conclusion proof size
                                    (plusFn $sf $sx $ss)
                                    (plusFn $ss 1 $s)
                                    ;; Make sure that it does not exceed budget
                                    (lte $s $budget))
                                 ;; Build concluding solution
                                 (, (sol $path $s (: (mp $f $x) $b)))))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Function call evaluator ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Evaluate all function calls prefixed by a bang
(exec (5 * main)
      (, (! $fx) (= $fx $bdy))
      (O (- (! $fx)) (+ $bdy)))

;;;;;;;;;;
;; Main ;;
;;;;;;;;;;

;; Load Peano to Integer conversion.  Make sure that gen-peano.mm2 has
;; been previously executed.
(exec (0)
      (I (ACT peano (toPeanoFn $x $k)))
      (, (toPeanoFn $x $k)
         (fromPeanoFn $k $x)))

;; Load lte
(exec (1)
      (I (ACT lte (lte $x $y))
         (BTM (fromPeanoFn $x $xi))
         (BTM (fromPeanoFn $y $yi)))
      (, (lte $xi $yi)))

;; Generate plusFn
(exec (1)
      (, (fromPeanoFn $k $x)
         (fromPeanoFn $l $y))
      (O (pure (plusFn $x $y $z)
               $z
               (i8_to_string (sum_i8 (i8_from_string $x) (i8_from_string $y))))))

;; Turn target into obc call
(exec (2)
      (, (target $budget (: $x $a)))
      (, (! (obc $budget . (: $x $a)))))

;; We use depth instead of proof size as budget for now

;; ;; impid (Implied Identity) (size=3, time=?)
;; (target 3 (: $x (→ (→ 𝜑 𝜓) (→ 𝜑 𝜑))))

;; ;; id (size=5, time=?, time-up-to=?)
;; (target 5 (: $x (→ 𝜑 𝜑)))

;; ;; pm2.43 (size=7, time=?, time-up-to=?)
;; (target 7 (: $x (→ (→ 𝜑 (→ 𝜑 𝜓)) (→ 𝜑 𝜓))))

;; jarr (size=13, time=?, time-up-to=?)
(target 13 (: $x (→ (→ (→ 𝜑 𝜓) 𝜒) (→ 𝜓 𝜒))))

;; ;; pm2.27 (size=13, time=?, time-up-to=?)
;; (target 13 (: $x (→ 𝜑 (→ (→ 𝜑 𝜓) 𝜓))))

;; ;; imim1 (size=15, time=?, time-up-to=?)
;; (target 15 (: $x (→ (→ 𝜑 𝜓) (→ (→ 𝜓 𝜒) (→ 𝜑 𝜒)))))

;; ;; loowoz (size=19, time=?, time-up-to=?)
;; (target 19 (: $x (→ (→ (→ 𝜑 𝜓) (→ 𝜑 𝜒)) (→ (→ 𝜓 𝜑) (→ 𝜓 𝜒)))))

;; ;; pm2.83 (size=25, time=?, time-up-to=?)
;; (target 25 (: $x (→ (→ 𝜑 (→ 𝜓 𝜒)) (→ (→ 𝜑 (→ 𝜒 𝜃)) (→ 𝜑 (→ 𝜓 𝜃))))))

;; ;; loolin (size=26, time=?, time-up-to=?)
;; (target 26 (: $x (→ (→ (→ 𝜑 𝜓) (→ 𝜓 𝜑)) (→ 𝜓 𝜑))))

;; Unify solution with target when maximum budget and hypotheses count
;; falls to zero.
(exec (4 0 0 0)
      (, (target $budget (: $tx $ta))
         (sol . $prfsize (: $tx $ta)))
      (, (final . $prfsize (: $tx $ta))))

;; Remove extraneous binary relations
(exec (5 0 0 0)
      (,)
      (, (binRelToRemove toPeanoFn)
         (binRelToRemove fromPeanoFn)
         (binRelToRemove lte)))
(exec (5 0 0 1)
      (, (binRelToRemove $r)
         ($r $x $y))
      (O (- (binRelToRemove $r))
         (- ($r $x $y))))

;; Remove extraneous trinary relations
(exec (5 0 0 2)
      (,)
      (, (triRelToRemove plusFn)))
(exec (5 0 0 3)
      (, (triRelToRemove $r)
         ($r $x $y $z))
      (O (- (triRelToRemove $r))
         (- ($r $x $y $z))))
